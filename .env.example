# Copier vers .env et renseigner les valeurs réelles.
# Le fichier .env ne doit PAS être versionné.

# --- API unifiée ---
GATEWAY_BASE_URL=http://127.0.0.1:8002

# --- Oracle Flexcube ---
ORACLE_USER=report_sn
ORACLE_PASSWORD=changeme
ORACLE_HOST=10.44.221.104
ORACLE_PORT=1522
ORACLE_SERVICE_NAME=FCPRDSNPDB

# Pool
ORACLE_POOL_SIZE=5
ORACLE_MAX_OVERFLOW=10
ORACLE_POOL_RECYCLE=1800
ORACLE_POOL_TIMEOUT=10

# Timeouts (ne pas dépasser le timeout HTTP du gateway ~60s)
ORACLE_CONNECT_TIMEOUT=10
ORACLE_CALL_TIMEOUT_MS=50000

